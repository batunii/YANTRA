*.iml
.gradle
/local.properties
/.idea
.DS_Store
build/
/captures
.externalNativeBuild
.cxx

# The release signing key and its passwords. The .jks is the app's identity — losing it means no
# further updates can ever be published under it, and committing it means anyone with the repo can
# publish as Yantra. Back it up out of band; do not track it here.
/keystore.properties
*.jks

# iOS. The Xcode project is generated from ios/project.yml by xcodegen; SwiftPM and xcodebuild
# products live under ios/build and .build.
/ios/Yantra.xcodeproj
# Every derived-data directory, not just the default one: the UI tests build per destination
# (ios/build, ios/build-ipad, …) and a stray one is fifty thousand files into a commit.
/ios/build*
/ios/**/.build
/ios/**/.swiftpm
