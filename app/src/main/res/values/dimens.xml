<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget geometry.

  A home-screen widget is not a card of ours: it is a tile in the launcher's grid, and since
  Android 12 the platform publishes the radius its own tiles use so that everything on the screen
  agrees. Matching it is the difference between a widget that sits in the grid and one that is
  pasted on top of it. The v31 copy of this file defers to the system values; these are the
  fallbacks for older launchers, which have no opinion to defer to.
-->
<resources>
    <dimen name="widget_radius">20dp</dimen>
    <!-- Anything drawn *inside* the widget: one step tighter, so the nesting reads. -->
    <dimen name="widget_inner_radius">14dp</dimen>
</resources>
