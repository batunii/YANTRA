<?xml version="1.0" encoding="utf-8"?>
<!--
  The bhupura as a *filled* shape, for use as a container behind widget content.

  Everywhere else in the app the mark is an outline enclosing something. Here it is the enclosure
  itself, tinted and sat behind a glyph — which is what Material's expressive shapes do with a
  clover or a cookie, except this is the shape the app already owns. Importing someone else's
  vocabulary of shapes into a design that has its own would be the wrong kind of modern.

  Same 28-unit geometry as the tray icon and the task glyph, scaled 0.857 into a 24dp box.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <group android:scaleX="0.857" android:scaleY="0.857">
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M8,4 L11,4 L11,2 L17,2 L17,4 L20,4 Q24,4 24,8 L24,11 L26,11 L26,17 L24,17 L24,20 Q24,24 20,24 L17,24 L17,26 L11,26 L11,24 L8,24 Q4,24 4,20 L4,17 L2,17 L2,11 L4,11 L4,8 Q4,4 8,4 Z" />
    </group>
</vector>
