<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Git-backed workspaces sync over HTTPS. Until now the app had never touched the network:
         everything it holds is local, and it stayed that way deliberately. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The completion choreography's feel channel: a LOW_TICK when a hold arms, a THUD when the
         bindu lands. Normal permission, no runtime prompt. It carries the whole reward when the
         user has animations turned off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- API 31/32: user-revocable exact-alarm permission; 33+ uses USE_EXACT_ALARM instead,
         which is auto-granted for alarm/reminder apps and needs no prompt. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperTasks">
        <!--
          MainActivity no longer carries LAUNCHER itself: the icon comes from whichever alias below
          is enabled, one per accent. An adaptive icon is a static resource resolved in the
          launcher's process, so this is the only way to make the mark follow the chosen ink.

          Exactly one alias is ever enabled, and LauncherIcon enables the new one before disabling
          the old — the reverse order would leave a moment with no launcher entry at all, which is
          an app you cannot open. Coral is enabled here so a fresh install has an icon before any
          code runs.

          Widgets, notifications and the quick-add tile target MainActivity by class and are
          unaffected by which alias is live.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LaunchCoral"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchJade"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_jade"
            android:roundIcon="@mipmap/ic_launcher_jade_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchAzure"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_azure"
            android:roundIcon="@mipmap/ic_launcher_azure_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchIndigo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchOrchid"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_orchid"
            android:roundIcon="@mipmap/ic_launcher_orchid_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen list widget -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Reachable from a placed widget's overflow button, not from the launcher's
             placement flow, so it is not an APPWIDGET_CONFIGURE handler. -->
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/widget_settings_title" />

        <receiver
            android:name=".widget.ListWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/list_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!--
            Named Pomodoro on purpose: a launcher binds each placed widget to this exact component
            name, so renaming it breaks every widget already on a home screen. See FocusWidget.kt.
        -->
        <receiver
            android:name=".widget.PomodoroWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_widget_info" />
        </receiver>

        <!--
            Yantra as somewhere to share to. Translucent and historyless like QuickAdd: it is an
            acknowledgement, not a screen, and the task exists before it draws.
        -->
        <activity
            android:name=".ui.share.ShareTargetActivity"
            android:exported="true"
            android:label="Add to Yantra"
            android:theme="@style/Theme.SuperTasks.QuickAdd"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.QuickAddActivity"
            android:exported="false"
            android:theme="@style/Theme.SuperTasks.QuickAdd"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reminders -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="false">
            <!-- All protected system broadcasts — delivered to non-exported receivers. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
